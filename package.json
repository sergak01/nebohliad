{
  "name": "nebohliad",
  "productName": "Nebohliad",
  "version": "1.1.3",
  "private": true,
  "description": "Небогляд: дві мапи повітряних загроз України в одному вікні",
  "author": "Serhii Shpak",
  "license": "MIT",
  "homepage": "https://github.com/sergak01/nebohliad",
  "repository": {
    "type": "git",
    "url": "https://github.com/sergak01/nebohliad.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build-info.js && electron-builder --win",
    "dist:dir": "node scripts/build-info.js && electron-builder --win --dir",
    "dist:local": "npm run dist:dir && node scripts/stock-exe.js",
    "dist:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dist-signed.ps1",
    "make-cert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-signing-cert.ps1"
  },
  "build": {
    "appId": "com.nebohliad.app",
    "productName": "Nebohliad",
    "copyright": "© 2026 Serhii Shpak",
    "afterPack": "scripts/after-pack.js",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "package.json",
      "build-info.json",
      "LICENSE",
      "*.js",
      "ui/**",
      "viewer/**",
      "assets/*.png",
      "assets/icon.ico"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nebohliad",
      "uninstallDisplayName": "Nebohliad",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nebohliad-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Nebohliad-${version}-portable.${ext}",
      "unpackDirName": "Nebohliad"
    }
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
